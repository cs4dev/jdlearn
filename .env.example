# Server
PORT=3000
MONGO_URL=mongodb://localhost:27017
MONGO_DB=jdlearn
BETTER_AUTH_SECRET=dev-secret-change-me-32chars-min-xxxx
BETTER_AUTH_URL=http://localhost:3000
# Origins allowed to call auth (web dev server runs on 5173). Comma-separated.
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# Google OAuth (optional). Set both to enable the "Continue with Google" button.
# Register redirect URI ${BETTER_AUTH_URL}/api/auth/callback/google in the Google console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic (server-only — never expose to client). RULES R5.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Where generated demo repos are materialized (sandbox root). RULES R4.
DATA_DIR=./data
